# Copy to terraform.tfvars (gitignored) and fill in real values.
#   cp terraform.tfvars.example terraform.tfvars

# Must be a region allowed by the AWS Projects SCP RegionFloor (this account: Sydney).
aws_region     = "ap-southeast-2"
domain_name    = "YOUR_ROOT_DOMAIN.com"
hosted_zone_id = "ZXXXXXXXXXXXXXXXXXXXX"
subdomain      = "review-insights"
instance_type  = "t3.small"
project_name   = "review-dashboard"
